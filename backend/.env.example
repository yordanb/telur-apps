# Database Configuration
# Port 5432 is the internal container port (not the host port)
DATABASE_URL=postgresql://postgres:postgres@db:5432/egg_production

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=egg_production

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Configuration
DEBUG=False
